# development | staging | production
CONFORMEO_APP_ENV=development

# PostgreSQL connection string used by FastAPI and bootstrap scripts.
CONFORMEO_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/conformeo

# Required outside development. Replace this placeholder in every real environment.
CONFORMEO_AUTH_TOKEN_SECRET=development-only-change-me

CONFORMEO_AUTH_ACCESS_TOKEN_TTL_MINUTES=480
CONFORMEO_CORS_ALLOW_ORIGINS=["http://localhost:4200","http://localhost:8100","http://127.0.0.1:4200","http://127.0.0.1:8100"]

# External integrations
CONFORMEO_EXTERNAL_INTEGRATIONS_ENABLED=true
CONFORMEO_EXTERNAL_PROVIDER_MAX_RETRIES=1
CONFORMEO_EXTERNAL_PROVIDER_USER_AGENT=Conformeo-API/0.1.0
CONFORMEO_EXTERNAL_CACHE_ENABLED=true
CONFORMEO_EXTERNAL_COMPANY_CACHE_TTL_SECONDS=3600
CONFORMEO_EXTERNAL_GEOCODE_CACHE_TTL_SECONDS=86400
CONFORMEO_EXTERNAL_REGULATION_CACHE_TTL_SECONDS=1800
CONFORMEO_EXTERNAL_SITE_RISKS_CACHE_TTL_SECONDS=1800

# Annuaire des Entreprises / SIRENE
CONFORMEO_EXTERNAL_ANNUAIRE_ENTREPRISES_ENABLED=true
CONFORMEO_EXTERNAL_ANNUAIRE_ENTREPRISES_BASE_URL=https://recherche-entreprises.api.gouv.fr
CONFORMEO_EXTERNAL_ANNUAIRE_ENTREPRISES_TIMEOUT_SECONDS=6.0

# Géocodage Géoplateforme
CONFORMEO_EXTERNAL_GEOPLATEFORME_ENABLED=true
CONFORMEO_EXTERNAL_GEOPLATEFORME_BASE_URL=https://data.geopf.fr/geocodage
CONFORMEO_EXTERNAL_GEOPLATEFORME_TIMEOUT_SECONDS=6.0

# Légifrance (PISTE)
CONFORMEO_EXTERNAL_LEGIFRANCE_ENABLED=false
CONFORMEO_EXTERNAL_LEGIFRANCE_ENVIRONMENT=production
CONFORMEO_EXTERNAL_LEGIFRANCE_BASE_URL=https://api.piste.gouv.fr
CONFORMEO_EXTERNAL_LEGIFRANCE_TOKEN_URL=https://oauth.piste.gouv.fr/api/oauth/token
CONFORMEO_EXTERNAL_LEGIFRANCE_CLIENT_ID=
CONFORMEO_EXTERNAL_LEGIFRANCE_CLIENT_SECRET=
CONFORMEO_EXTERNAL_LEGIFRANCE_SCOPE=openid
CONFORMEO_EXTERNAL_LEGIFRANCE_OAUTH_GRANT_TYPE=client_credentials
CONFORMEO_EXTERNAL_LEGIFRANCE_TIMEOUT_SECONDS=8.0
CONFORMEO_EXTERNAL_LEGIFRANCE_DEFAULT_SORT=DATE_DESC

# Géorisques v2
CONFORMEO_EXTERNAL_GEORISQUES_ENABLED=false
CONFORMEO_EXTERNAL_GEORISQUES_BASE_URL=https://www.georisques.gouv.fr
CONFORMEO_EXTERNAL_GEORISQUES_API_TOKEN=
CONFORMEO_EXTERNAL_GEORISQUES_TIMEOUT_SECONDS=8.0
